# Copy to .env.local and fill in your own values. Never commit .env.local.

# ── Audio generation (Google Cloud Text-to-Speech) ──────────
# Create the key at: Google Cloud Console → APIs & Services → Credentials.
# Restrict it to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
TTS_VOICE=de-DE-Neural2-F
# Per-speaker dialogue voices (female speakers + male speakers):
TTS_VOICE_FEMALE=de-DE-Neural2-F
TTS_VOICE_MALE=de-DE-Neural2-B

# ── Klarweg AI ─────────────────────────────────────────────
# Not configured here. The AI tutor runs in the private klarweg-tutor
# Cloudflare Worker (tutor/worker). Its provider key is a Worker secret:
#   cd tutor/worker && npx wrangler secret put GEMINI_API_KEY   (or OPENAI_/ANTHROPIC_)
# Provider, model and prices are [vars] in tutor/worker/wrangler.toml;
# quotas and the kill switch (AI_ENABLED) are in access/worker/wrangler.toml.
# To benchmark a provider locally (spends money; needs --confirm-spend):
#   LLM_PROVIDER=gemini LLM_MODEL=<id> GEMINI_API_KEY=… npm run tutor:eval -- --confirm-spend
