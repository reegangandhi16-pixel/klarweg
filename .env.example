# Copy to .env.local and fill in your own values. Never commit .env.local.

# ── Audio generation (Google Cloud Text-to-Speech) ──────────
# Create the key at: Google Cloud Console → APIs & Services → Credentials.
# Restrict it to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here
TTS_VOICE=de-DE-Neural2-F
# Per-speaker dialogue voices (female speakers + male speakers):
TTS_VOICE_FEMALE=de-DE-Neural2-F
TTS_VOICE_MALE=de-DE-Neural2-B

# ── AI Tutor (server-side only — NEVER expose to the browser) ──
# Provider-agnostic switch: gemini (default) | anthropic | openai
LLM_PROVIDER=gemini

# Google Gemini — primary provider.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Any current Gemini model id (gemini-1.5-flash is cheapest; gemini-1.5-pro is stronger)
LLM_MODEL=gemini-1.5-flash

# Anthropic — alternative provider (used only when LLM_PROVIDER=anthropic).
# Get a key at: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Auth (session gate on /api/chat) ──────────────────────────
# If you use NextAuth/Clerk/Supabase, replace lib/auth.ts getSessionUser()
# instead. These back the built-in signed-cookie verifier:
SESSION_COOKIE_NAME=kw_session
SESSION_SECRET=replace-with-a-long-random-string

# ── Distributed rate limiting + budget (Upstash Redis or Vercel KV) ──
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# (Vercel KV alternative: KV_REST_API_URL / KV_REST_API_TOKEN)
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_USER_MAX=20
RATE_LIMIT_WINDOW_MS=300000
# Allow requests through if Redis is unreachable? Default false (fail closed).
RATE_LIMIT_FAIL_OPEN=false
# Global daily token ceiling — trips the spend breaker.
DAILY_TOKEN_BUDGET=5000000

# ── Security ──────────────────────────────────────────────────
# Comma-separated allowed browser origins (empty = allow, for local dev).
ALLOWED_ORIGINS=https://klarweg.com,https://www.klarweg.com
