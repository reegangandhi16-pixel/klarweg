},{"section":"speaking","type":"speaking-model","idx":1,"text":"Ich heiße Timo. Ich arbeite als Aushilfe und suche eine neue Stelle.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-16-goethe-mini-2","level":"A2"},{"chapter":"a2-16-goethe-mini-2","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Prüfung, Teil 1: Stell dich vor und sag, was du beruflich machst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Auf dem Bild sieht man den Dom. Vor dem Dom stehen viele Touristen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-16-goethe-mini-2","level":"A2"},{"chapter":"a2-16-goethe-mini-2","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Prüfung, Teil 2: Beschreibe ein Bild — die Innenstadt mit dem Dom.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Das Vorstellungsgespräch war gut. Nächste Woche habe ich einen Probetag.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-16-goethe-mini-2","level":"A2"},{"chapter":"a2-16-goethe-mini-2","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Prüfung, Teil 3: Deine Partnerin fragt nach dem Vorstellungsgespräch.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Wir nehmen die Seilbahn und treffen uns am Stadtplan beim Dom.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-16-goethe-mini-2","level":"A2"},{"chapter":"a2-16-goethe-mini-2","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Prüfung, Teil 3: Plant zusammen einen Ausflug in die Innenstadt.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":8,"story-play-all":1,"vword-voice-F":59,"vword-voice-M":59,"vword-listen":59,"list