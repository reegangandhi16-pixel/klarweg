"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, es regnet stark.","speaker":"Merle","voiceRole":"female","authoredLineId":"A2_024_L001","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Fährst du trotzdem mit dem Rad?","speaker":"Merle","voiceRole":"female","authoredLineId":"A2_024_L001","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Ja, ich fahre trotzdem, ich mag Regen nicht so sehr, aber ich muss zur Arbeit.","speaker":"Timo","voiceRole":"male","authoredLineId":"A2_024_L002","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Und ich bleibe deshalb heute lieber zu Hause.","speaker":"Merle","voiceRole":"female","authoredLineId":"A2_024_L003","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Verständlich!","speaker":"Timo","voiceRole":"male","authoredLineId":"A2_024_L004","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Bis morgen dann.","speaker":"Timo","voiceRole":"male","authoredLineId":"A2_024_L004","control":"button.audio-play-btn (sequence)","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, es regnet stark. Fährst du trotzdem mit dem Rad?","speaker":"Merle","voiceRole":"female","authoredLineId":"A2_024_L001","reachable":false},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"listening","type":"listening-authored-line","idx":2,"text":"Ja, ich fahre trotzdem, ich mag Regen nicht so sehr, aber ich muss zur Arbeit.","speaker":"Timo","voiceRole":"male","authoredLineId":"A2_024_L002","reachable":false},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"listening","type":"listening-authored-line","idx":3,"text":"Und ich bleibe deshalb heute lieber zu Hause.","speaker":"Merle","voiceRole":"female","authoredLineId":"A2_024_L003","reachable":false},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"listening","type":"listening-authored-line","idx":4,"text":"Verständlich! Bis morgen dann.","speaker":"Timo","voiceRole":"male","authoredLineId":"A2_024_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Es war Nebel, deshalb bin ich zu Hause geblieben.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Dein Freund fragt: Warum bist du nicht surfen gegangen?","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Es hat geregnet, trotzdem war die Strecke genial.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Deine Cousine fragt: Wie war die Radtour bei dem Wetter?","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Ich wohne hier, deshalb kenne ich das Gebiet gut.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"a2-24-deshalb-trotzdem","level":"A2"},{"chapter":"a2-24-deshalb-trotzdem","level":"A2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Dein Freund fragt: Warum kennst du den Wanderweg so gut?","voiceRole":"narrator-fem