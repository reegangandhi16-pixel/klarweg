{"chapter":"a2-35-goethe-mini-4","level":"A2","number":35,"title":"Goethe A2 Final","rows":[{"section":"story","type":"story-line","idx":1,"text":"Nächste Woche ist die Prüfung Hat jemand schon alles wiederholt","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":2,"text":"Ich habe manche Themen wiederholt aber nicht alle","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":3,"text":"Woran denkst du am meisten","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":4,"text":"Ich denke an den Konjunktiv Wenn ich mehr Zeit hätte würde ich mehr üben","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":5,"text":"Das verstehe ich Worauf freust du dich nach der Prüfung","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":6,"text":"Ich freue mich auf freie Zeit Niemand wird mich mehr stressen","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":7,"text":"Genau Wir schaffen das zusammen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"story","type":"story-line","idx":8,"text":"Ja das schaffen wir","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"a2-35-goethe-mini-4","level":"A2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"genauso","voiceRole":"female","pos":"adverb","control":"button.v