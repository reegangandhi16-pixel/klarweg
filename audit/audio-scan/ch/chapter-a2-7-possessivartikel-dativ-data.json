tening","type":"listening-sentence","idx":1,"text":"Nils, wie geht es deiner Katze?","speaker":"Silke","voiceRole":"female","authoredLineId":"A2_007_L001","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Ihr geht es gut, aber sie versteckt sich vor unseren Gästen.","speaker":"Nils","voiceRole":"male","authoredLineId":"A2_007_L002","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Meine Katze spielt gern mit ihrem Ball.","speaker":"Silke","voiceRole":"female","authoredLineId":"A2_007_L003","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Süß!","speaker":"Nils","voiceRole":"male","authoredLineId":"A2_007_L004","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Schläft sie bei deinen Eltern, wenn du reist?","speaker":"Nils","voiceRole":"male","authoredLineId":"A2_007_L004","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Ja, sie bleibt immer bei meiner Mutter.","speaker":"Silke","voiceRole":"female","authoredLineId":"A2_007_L005","control":"button.audio-play-btn (sequence)","chapter":"a2-7-possessivartikel-dativ","level":"A2"},{"chapter":"a2-7-possessivartikel-dativ","level":"A2","section":"listening","type":"listening-authored-line","idx":1,"text":"Nils, wie geht es deiner Katze?","speaker":"Silke","voiceRole":"female","authoredLineId":"A2_007_L001","reachable":false},{"chapter":"a2-7-possessivartikel-dativ","level":"A2","section":"listening","type":"listening-authored-line","idx":2,"text":"Ihr ge