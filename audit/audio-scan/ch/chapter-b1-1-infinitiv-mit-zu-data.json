{"chapter":"b1-1-infinitiv-mit-zu","level":"B1","number":1,"title":"Infinitiv mit zu","rows":[{"section":"story","type":"story-line","idx":1,"text":"Ich habe vor im Urlaub zu zelten","speaker":"Renke","voiceRole":"female","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":2,"text":"Das klingt entspannend Hast du auch vor zu faulenzen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":3,"text":"Ja Ich habe vor viel Zeit zu haben im Freien","speaker":"Renke","voiceRole":"female","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":4,"text":"Und hast du vor dich zu erholen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":5,"text":"Ja genau Es ist ein herrliches Erlebnis","speaker":"Renke","voiceRole":"female","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":6,"text":"Wieso fährst du genau dorthin","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":7,"text":"Die Aussicht dort ist einfach herrlich","speaker":"Renke","voiceRole":"female","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"story","type":"story-line","idx":8,"text":"Dann habe ich vor mitzukommen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-1-infinitiv-mit-zu","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"das Erlebnis","voiceRole":"female","pos":"noun","gender":"n","control":"button.vword-voice[data-g=female]","chapter":"b1-1-infin