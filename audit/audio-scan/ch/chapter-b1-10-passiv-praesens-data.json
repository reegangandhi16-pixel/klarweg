arrator-female","block":"Was ist das Passiv?","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":2,"sub":1,"text":"Das Auto wird repariert.","voiceRole":"narrator-female","block":"Bildung: werden + Partizip II","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":2,"sub":2,"text":"Die Tür wird geöffnet.","voiceRole":"narrator-female","block":"Bildung: werden + Partizip II","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":2,"sub":3,"text":"Das Haus wird verkauft.","voiceRole":"narrator-female","block":"Bildung: werden + Partizip II","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":2,"sub":4,"text":"Der Brief wird geschrieben.","voiceRole":"narrator-female","block":"Bildung: werden + Partizip II","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":3,"sub":1,"text":"Ich werde gefragt.","voiceRole":"narrator-female","block":"Konjugation von werden (Präsens)","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":3,"sub":2,"text":"Du wirst eingeladen.","voiceRole":"narrator-female","block":"Konjugation von werden (Präsens)","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":3,"sub":3,"text":"Wir werden informiert.","voiceRole":"narrator-female","block":"Konjugation von werden (Präsens)","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":5,"sub":1,"text":"Hier wird nicht geraucht.","voiceRole":"narrator-female","block":"Typische Goethe-B1-Situationen","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":5,"sub":2,"text":"Im Museum darf nicht fotografiert werden.","voiceRole":"narrator-female","block":"Typische Goethe-B1-Situationen","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":5,"sub":3,"text":"Deutsch wird in vielen Ländern gesprochen.","voiceRole":"narrator-female","block":"Typische Goethe-B1-Situationen","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"grammar","type":"grammar-example","idx":5,"sub":4,"text":"Das Büro wird um 9 Uhr geöffnet.","voiceRole":"narrator-female","block":"Typische Goethe-B1-Situationen","control":".example-line[click]","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Willkommen im Salon Krause Hier wird jeder Besuch entspannt gestaltet Zuerst werden die Haare gewaschen danach werden sie mit Kamm und Schere geschnitten Auf Wunsch werden die Haare auch gefärbt Schließlich werden sie mit einer Bürste geföhnt Termine werden online oder telefonisch vergeben","authoredText":"Willkommen im Salon Krause! Hier wird jeder Besuch entspannt gestaltet. Zuerst werden die Haare gewaschen, danach werden sie mit Kamm und Schere geschnitten. Auf Wunsch werden die Haare auch gefärbt. Schließlich werden sie mit einer Bürste geföhnt. Termine werden online oder telefonisch vergeben.","voiceRole":"narrator-female","title":"Der Ablauf beim Friseur","control":"button \"Listen to passage\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Frau Bruns, warum ist das ganze Museum geschlossen?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_010_L001","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Weil gerade das große Gemälde restauriert wird — das dauert leider den ganzen Tag.","speaker":"Frau Bruns","voiceRole":"female","authoredLineId":"B1_010_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Schade.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_010_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Wird es morgen wieder geöffnet?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_010_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Ja, ab neun Uhr.","speaker":"Frau Bruns","voiceRole":"female","authoredLineId":"B1_010_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Dann wird auch die neue Ausstellung eröffnet.","speaker":"Frau Bruns","voiceRole":"female","authoredLineId":"B1_010_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"listening","type":"listening-authored-line","idx":1,"text":"Frau Bruns, warum ist das ganze Museum geschlossen?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_010_L001","reachable":false},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"listening","type":"listening-authored-line","idx":2,"text":"Weil gerade das große Gemälde restauriert wird — das dauert leider den ganzen Tag.","speaker":"Frau Bruns","voiceRole":"female","authoredLineId":"B1_010_L002","reachable":false},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"listening","type":"listening-authored-line","idx":3,"text":"Schade. Wird es morgen wieder geöffnet?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_010_L003","reachable":false},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"listening","type":"listening-authored-line","idx":4,"text":"Ja, ab neun Uhr. Dann wird auch die neue Ausstellung eröffnet.","speaker":"Frau Bruns","voiceRole":"female","authoredLineId":"B1_010_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Hier wird nicht fotografiert, und die Bilder werden nicht berührt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Du bist mit einem Gast im Museum. Er fragt, was hier nicht erlaubt ist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Zuerst wird das Gemüse geschnitten, dann wird alles langsam gekocht.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Ein Freund will dein Lieblingsgericht kochen. Erklär ihm den Ablauf.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Die Haare werden gewaschen, geschnitten und dann geföhnt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Freundin fragt, was beim Friseur mit ihren Haaren gemacht wird.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Das große Gemälde wird restauriert. Morgen wird wieder geöffnet.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Ein Gast fragt, warum das Museum heute geschlossen ist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Hier wird jeden Morgen frisch gekocht, und um elf wird geöffnet.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Du zeigst einem Gast den Imbiss, in dem du arbeitest.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Die Küche wird jeden Abend geputzt, und der Müll wird montags rausgebracht.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Deine Mitbewohnerin fragt, wie die Aufgaben in der Wohnung verteilt sind.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":7,"text":"Es wurde gesagt, dass die neue Ausstellung morgen eröffnet wird.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-10-passiv-praesens","level":"B1"},{"chapter":"b1-10-passiv-praesens","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":7,"text":"Im Museum kommt eine Ansage. Erklär einem Gast, was gesagt wurde.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":8,"story-play-all":1,"vword-voice-F":27,"vword-voice-M":27,"vword-listen":27,"example-line":14,"listen-to-passage":1,"audio-play-btn":1,"hear-model":7},"surfaces":[{"n":1,"w":"Absichten","from":"vocab-plural","type":"Noun · plural"},{"n":8,"w":