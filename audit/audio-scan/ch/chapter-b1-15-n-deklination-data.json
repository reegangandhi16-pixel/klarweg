=male]","chapter":"b1-15-n-deklination","level":"B1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Der Richter eröffnete die Gerichtsverhandlung und sah den Angeklagten ernst an Der Rechtsanwalt des Angeklagten sprach ruhig Wegen des wichtigen Falls kam auch ein Reporter ins Gericht Der Reporter befragte einen Polizisten Obwohl die Öffentlichkeit gespannt war sprach die Richterin ein gerechtes Urteil Deshalb verließ der Angeklagte das Gericht erleichtert","authoredText":"Der Richter eröffnete die Gerichtsverhandlung und sah den Angeklagten ernst an. Der Rechtsanwalt des Angeklagten sprach ruhig. Wegen des wichtigen Falls kam auch ein Reporter ins Gericht. Der Reporter befragte einen Polizisten. Obwohl die Öffentlichkeit gespannt war, sprach die Richterin ein gerechtes Urteil. Deshalb verließ der Angeklagte das Gericht erleichtert.","voiceRole":"narrator-female","title":"Der Prozess","control":"button \"Listen to passage\"","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Silje, kennst du einen guten Anwalt?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_015_L001","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Ich brauche Hilfe mit meinem Vertrag.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_015_L001","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Klar, ich kenne einen Kollegen.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Er hat schon vielen Kunden geholfen.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Und traust du diesem Kollegen wirklich?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_015_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Absolut.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"section":"listening","type":"listening-sentence","idx":7,"text":"Ich habe selbst mit diesem Experten gearbeitet — er ist sehr genau.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"listening","type":"listening-authored-line","idx":1,"text":"Silje, kennst du einen guten Anwalt? Ich brauche Hilfe mit meinem Vertrag.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_015_L001","reachable":false},{"chapter":"b1-15-n-deklination","level":"B1","section":"listening","type":"listening-authored-line","idx":2,"text":"Klar, ich kenne einen Kollegen. Er hat schon vielen Kunden geholfen.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L002","reachable":false},{"chapter":"b1-15-n-deklination","level":"B1","section":"listening","type":"listening-authored-line","idx":3,"text":"Und traust du diesem Kollegen wirklich?","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_015_L003","reachable":false},{"chapter":"b1-15-n-deklination","level":"B1","section":"listening","type":"listening-authored-line","idx":4,"text":"Absolut. Ich habe selbst mit diesem Experten gearbeitet — er ist sehr genau.","speaker":"Silje","voiceRole":"female","authoredLineId":"B1_015_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Ich kenne einen Studenten aus Kenia, und dem Studenten helfe ich beim Deutsch.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Deine Familie fragt, wen du im Kurs kennengelernt hast.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Der Briefträger kommt um zehn. Ich sehe den Briefträger jeden Tag.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Ein Freund fragt, wer bei euch die Post bringt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Der Mechatroniker stellt sie her, und ich helfe dem Mechatroniker manchmal.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Eine Kollegin fragt, wer die Teile herstellt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Wir haben dem Touristen den Weg erklärt und dem Touristen die Karte gegeben.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Rollenspiel: Ein Tourist findet den Weg nicht. Ihr helft ihm.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Mein Onkel ist Chemiker, und mein Cousin arbeitet als Elektroingenieur.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Deine Nichte fragt, welche Berufe es in deiner Familie gibt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Der Zeuge hat vor Gericht gesprochen, aber dem Zeugen hat niemand geglaubt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Im Kurs geht es um ein Verbrechen aus den Nachrichten. Erzähl davon.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":7,"text":"Wir sehen den Löwen, den Elefanten und einen Affen im Baum.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-15-n-deklination","level":"B1"},{"chapter":"b1-15-n-deklination","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":7,"text":"Du bist mit einem Kind im Zoo. Erklär, was ihr seht.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":8,"story-play-all":1,"vword-voice-F":52,"vword-voice-M":52,"vword-listen":52,"listen-to-passage":1,"audio-play-btn":1,"hear-model":7},"surfaces":[{"n":1,"w":"Einkommen","from":"vocab-plural","type":"Noun · plural"},{"n":5,"w":"das","from":"vocab-article","type":"Article"},{"n":1,"w":"Entwicklungen","from":"vocab-plural","type":"Noun · plural"},{"n":23,"w":"die","from":"vocab-article","type":"Article"},{"n":4,"w":"— (Sg.)","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Gerichte","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Metalle","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Urteile","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Verbrechen","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Augenblicke","from":"