{"chapter":"b1-21-temporale-nebensaetze","level":"B1","number":21,"title":"Temporale Nebensätze","rows":[{"section":"story","type":"story-line","idx":1,"text":"Seitdem du hier wohnst ist es lauter geworden","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":2,"text":"Bevor ich etwas sage will ich zuhören","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":3,"text":"Gut Während ich schlafe hörst du Musik","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":4,"text":"Das tut mir leid Seit letzter Woche trage ich Kopfhörer","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":5,"text":"Danke Bevor wir weiterreden möchte ich dir auch danken","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":6,"text":"Wofür","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"story","type":"story-line","idx":7,"text":"Seitdem wir darüber sprechen fühle ich mich erleichtert","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Konfliktsituation","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Konfliktsituation","vo