"},{"section":"vocabulary","type":"vocab-headword","idx":29,"text":"als","voiceRole":"male","pos":"conjunction","control":"button.vword-voice[data-g=male]","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Als wir uns kennenlernten waren wir beide undiplomatisch Wenn einer von uns erschöpft war übertrieben wir beide oft Nachdem ein größerer Streit zu Ende gewesen war einigten wir uns endlich auf Ich-Aussagen Bevor wir weiterredeten atmeten wir beide tief durch Während wir sprachen hörte jeder genau zu","authoredText":"Als wir uns kennenlernten, waren wir beide undiplomatisch. Wenn einer von uns erschöpft war, übertrieben wir beide oft. Nachdem ein größerer Streit zu Ende gewesen war, einigten wir uns endlich auf Ich-Aussagen. Bevor wir weiterredeten, atmeten wir beide tief durch. Während wir sprachen, hörte jeder genau zu.","voiceRole":"narrator-female","title":"Wie wir wieder zueinander fanden","control":"button \"Listen to passage\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Runa, seit wir letzte Woche gestritten haben, ist es komisch zwischen uns.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_021_L001","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Ich weiß, das tut mir leid.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Bevor ich wieder laut Musik höre, frage ich dich einfach.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Das reicht schon.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_021_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Und ich werde leiser sein, während du schläfst.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_021_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Perfekt.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"section":"listening","type":"listening-sentence","idx":7,"text":"Nachdem wir das geklärt haben, fühle ich mich viel besser.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"listening","type":"listening-authored-line","idx":1,"text":"Runa, seit wir letzte Woche gestritten haben, ist es komisch zwischen uns.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_021_L001","reachable":false},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"listening","type":"listening-authored-line","idx":2,"text":"Ich weiß, das tut mir leid. Bevor ich wieder laut Musik höre, frage ich dich einfach.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L002","reachable":false},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"listening","type":"listening-authored-line","idx":3,"text":"Das reicht schon. Und ich werde leiser sein, während du schläfst.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_021_L003","reachable":false},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"listening","type":"listening-authored-line","idx":4,"text":"Perfekt. Nachdem wir das geklärt haben, fühle ich mich viel besser.","speaker":"Runa","voiceRole":"female","authoredLineId":"B1_021_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Seit wir gestritten haben, ist es komisch zwischen uns.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Deine Freundin sagt, seit dem Streit sei es komisch. Antworte.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Bevor ich laut Musik höre, frage ich dich einfach.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Sag, was du machst, bevor du laut Musik hörst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Seitdem wir offen reden, gibt es weniger Streit.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Ein Freund fragt, wie sich alles geändert hat.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Während ich arbeite, geht es, aber danach bin ich erschöpft.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Deine Kollegin fragt, wann du erschöpft bist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Wenn ich ruhig bin, kann ich Kritik akzeptieren.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Ein Freund fragt, wann du Kritik akzeptieren kannst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Bevor ich mich aufrege, schweige ich einen Moment.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Deine Freundin fragt, was du im Streit machst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":7,"text":"Seitdem du früher aufstehst, schlafe ich schlecht. — Bevor ich dusche, mache ich die Tür zu.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-21-temporale-nebensaetze","level":"B1"},{"chapter":"b1-21-temporale-nebensaetze","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":7,"text":"Rollenspiel: Ihr klärt einen Streit in der Wohnung.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":7,"story-play-all":1,"vword-voice-F":29,"vword-voice-M":29,"vword-listen":29,"listen-to-passage":1,"audio-play-btn":1,"hear-model":7},"surfaces":[{"n":1,"w":"Konfliktsituationen","from":"vocab-plural","type":"Noun · plural"},{"n":6,"w":"die","from":"vocab-article","type":"Article"},{"n":1,"w":"Kritiken","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Streitgespräche","from":"vocab-plural","type":"Noun · plural"},{"n":2,"w":"das","from":"vocab-article","type":"Article"},{"n":1,"w":"Wörter","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Schülerjobs","from":