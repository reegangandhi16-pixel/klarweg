":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":38,"text":"nervös","voiceRole":"female","pos":"adjective","control":"button.vword-voice[data-g=female]","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":38,"text":"nervös","voiceRole":"male","pos":"adjective","control":"button.vword-voice[data-g=male]","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":39,"text":"beide","voiceRole":"female","pos":"pronoun","control":"button.vword-voice[data-g=female]","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"vocabulary","type":"vocab-headword","idx":39,"text":"beide","voiceRole":"male","pos":"pronoun","control":"button.vword-voice[data-g=male]","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Nachdem Anna die Wohnung besichtigt hatte wurde der Vertrag schnell unterschrieben Die wartenden Interessenten mussten sich gedulden Zwar war die Miete hoch aber sowohl die Lage als auch die Ausstattung überzeugten Nicht der Preis entschied sondern das Gefühl zu Hause anzukommen","authoredText":"Nachdem Anna die Wohnung besichtigt hatte, wurde der Vertrag schnell unterschrieben. Die wartenden Interessenten mussten sich gedulden. Zwar war die Miete hoch, aber sowohl die Lage als auch die Ausstattung überzeugten. Nicht der Preis entschied, sondern das Gefühl, zu Hause anzukommen.","voiceRole":"narrator-female","title":"Goethe-Zertifikat B1 · Lesen — Fünf Texte","control":"button \"Listen to passage\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Silke, ich bin heute Morgen so nervös, ich habe kaum geschlafen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_035_L001","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Das kenne ich.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Aber denk daran, wir haben alles wiederholt, was wichtig ist.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L002","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Stimmt.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_035_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Und egal, was passiert, wir haben es zusammen geschafft, so weit zu kommen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_035_L003","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Genau.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"section":"listening","type":"listening-sentence","idx":7,"text":"Jetzt trink erst mal einen Kaffee, dann gehen wir rein.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L004","control":"button.audio-play-btn (sequence)","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"listening","type":"listening-authored-line","idx":1,"text":"Silke, ich bin heute Morgen so nervös, ich habe kaum geschlafen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_035_L001","reachable":false},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"listening","type":"listening-authored-line","idx":2,"text":"Das kenne ich. Aber denk daran, wir haben alles wiederholt, was wichtig ist.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L002","reachable":false},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"listening","type":"listening-authored-line","idx":3,"text":"Stimmt. Und egal, was passiert, wir haben es zusammen geschafft, so weit zu kommen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B1_035_L003","reachable":false},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"listening","type":"listening-authored-line","idx":4,"text":"Genau. Jetzt trink erst mal einen Kaffee, dann gehen wir rein.","speaker":"Silke","voiceRole":"female","authoredLineId":"B1_035_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Wir haben alles wiederholt, was wichtig ist.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Deine Partnerin hat kaum geschlafen. Beruhige sie.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Ich hoffe, die Prüfung zu bestehen, damit ich hier arbeiten kann.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Prüfung, Teil 1: Stell dich vor und sag, was du hoffst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Je öfter ich spreche, desto sicherer werde ich.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Teil 2: Sprich über Vorbereitung.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Mir hat sowohl das Sprechen als auch das Lesen gefallen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Ein Freund fragt, was dir am Kurs gefallen hat.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Nachdem ich die Prüfung geschrieben habe, mache ich frei.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Eine Partnerin fragt, was du nach der Prüfung machst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Wir könnten einen Tisch reservieren. Ich brauche nur zu bestellen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Teil 3: Plant zusammen die Feier nach der Prüfung.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":7,"text":"Ich drücke dir die Daumen. — Egal, was passiert, es hat sich ausgezahlt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1"},{"chapter":"b1-35-goethe-zertifikat-b1-final","level":"B1","se