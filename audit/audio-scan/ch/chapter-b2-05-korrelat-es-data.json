ontrol":"button.vword-voice[data-g=male]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"meinetwegen","voiceRole":"female","pos":"adverb","control":"button.vword-voice[data-g=female]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"meinetwegen","voiceRole":"male","pos":"adverb","control":"button.vword-voice[data-g=male]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"das Melodram","voiceRole":"female","pos":"noun","gender":"n","control":"button.vword-voice[data-g=female]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"das Melodram","voiceRole":"male","pos":"noun","gender":"n","control":"button.vword-voice[data-g=male]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"die Merkformel","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"die Merkformel","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":34,"text":"der Mietvertrag","voiceRole":"female","pos":"noun","gender":"m","control":"button.vword-voice[data-g=female]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":34,"text":"der Mietvertrag","voiceRole":"male","pos":"noun","gender":"m","control":"button.vword-voice[data-g=male]","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"reading","type":"reading-passage","idx":1,"text":"Es überrascht nicht dass der neue Kinofilm schon in der ersten Woche die Kinokasse gesprengt hat Das Melodram erzählt von einer jungen Schauspielerin der die Hauptrolle anfangs ziemlich schwerfällt Es lässt sich kaum leugnen dass die Regie ihr am Ende zu einem wahren Horizont verhilft Auch wenn die Landessprache des Films nicht jedem leichtfällt lohnt sich der Kinobesuch Es ist kein Zufall dass der Jury­vorsitz dem Kameramann für sein gesamtes Langspielfilm-Werk gedankt hat","authoredText":"Es überrascht nicht, dass der neue Kinofilm schon in der ersten Woche die Kinokasse gesprengt hat. Das Melodram erzählt von einer jungen Schauspielerin, der die Hauptrolle anfangs ziemlich schwerfällt. Es lässt sich kaum leugnen, dass die Regie ihr am Ende zu einem wahren Horizont verhilft. Auch wenn die Landessprache des Films nicht jedem leichtfällt, lohnt sich der Kinobesuch. Es ist kein Zufall, dass der Jury­vorsitz dem Kameramann für sein gesamtes Langspielfilm-Werk gedankt hat.","voiceRole":"narrator-female","title":"Filmkritik: Ein Melodram, das im Gedächtnis bleibt","control":"button \"Listen to passage\"","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, es fällt mir wirklich schwer, mich zwischen Grafikdesign und Filmemachen zu entscheiden.","speaker":"Merle","voiceRole":"female","authoredLineId":"B2_005_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Es hat mich gefreut zu hören, dass du überhaupt darüber nachdenkst — das war früher kein Thema.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_005_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Stimmt.","speaker":"Merle","voiceRole":"female","authoredLineId":"B2_005_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Es macht mir jedenfalls Spaß, beides mal auszuprobieren.","speaker":"Merle","voiceRole":"female","authoredLineId":"B2_005_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-05-korrelat-es","level":"B2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Dann lass dir Zeit damit, es muss ja nicht heute entschieden werden.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_005_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, es fällt mir wirklich schwer, mich zwischen Grafikdesign und Filmemachen zu entscheiden.","speaker":"Merle","voiceRole":"female","authoredLineId":"B2_005_L001","reachable":false},{"chapter":"b2-05-korrelat-es","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Es hat mich gefreut zu hören, dass du überhaupt darüber nachdenkst — das war früher kein Thema.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_005_L002","reachable":false},{"chapter":"b2-05-korrelat-es","level":"B2","section":"listening","type":"listening-authored-line","idx":3,"text":"Stimmt. Es macht mir jedenfalls Spaß, beides mal auszuprobieren.","speaker":"Merle","voiceRole":"female","authoredLineId":"B2_005_L003","reachable":false},{"chapter":"b2-05-korrelat-es","level":"B2","section":"listening","type":"listening-authored-line","idx":4,"text":"Dann lass dir Zeit damit, es muss ja nicht heute entschieden werden.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_005_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Es fällt mir schwer, mich zwischen Grafikdesign und Filmemachen zu entscheiden.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Du kannst dich nicht entscheiden. Sag es deinem Freund.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Es hat mich gefreut, dass du überhaupt darüber nachdenkst.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Er freut sich, dass du überlegst. Antworte in seinem Ton.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Es ärgert mich, dass Informatik im Stundenplan fehlt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Kollegin fragt, was dich am Studium stört.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Es überrascht mich, dass sie die Hauptrolle bekommen hat.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Ein Freund fragt nach der Hauptrolle im Kinofilm.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Es stört mich, dass der Vertrag zwei Jahre läuft.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-05-korrelat-es","level":"B2"},{"chapter":"b2-05-korrelat-es","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Eine Bekannte fragt nach dem Handyvertrag.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Es freut mich, dass du die Hochschulreife hast. — Aber es macht mich nervös, dass ich wählen muss.","voiceRole":"narrato