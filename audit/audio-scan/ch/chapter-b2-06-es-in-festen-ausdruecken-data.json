{"chapter":"b2-06-es-in-festen-ausdruecken","level":"B2","number":6,"title":"Es in festen Ausdrücken","rows":[{"section":"story","type":"story-line","idx":1,"text":"Worum geht es in diesem Spielfilm","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"story","type":"story-line","idx":2,"text":"Es handelt sich um ein Migrantenkind","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"story","type":"story-line","idx":3,"text":"Kommt es darauf an wie man es sieht","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"story","type":"story-line","idx":4,"text":"Mir geht es gut mit dem Thema","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"story","type":"story-line","idx":5,"text":"Gibt es viele Szenen dazu","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"story","type":"story-line","idx":6,"text":"Ja und es macht Spaß den Film zu sehen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"das Migrantenkind","voiceRole":"female","pos":"noun","gender":"n","control":"button.vword-voice[data-g=female]","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"das Migrantenkind","voiceRole":"male","pos":"noun","gender":"n","control":"button.vword-voice[data-g=male]","chapter":"b2-06-es-in-festen-ausdruecken","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"das Milieu","voiceRole":"female","pos":"noun",