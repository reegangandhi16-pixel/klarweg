{"chapter":"b2-08-valenz-von-verben","level":"B2","number":8,"title":"Valenz von Verben","rows":[{"section":"story","type":"story-line","idx":1,"text":"Als Sprachwissenschaftlerin beurteile ich die Studie als sehr wichtig","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"story","type":"story-line","idx":2,"text":"Widerspricht das den alten Ergebnissen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"story","type":"story-line","idx":3,"text":"Nein die Sprachentwicklung ist tatsächlich schneller","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"story","type":"story-line","idx":4,"text":"Fordert die Studie Familien auf mehr zu sprechen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"story","type":"story-line","idx":5,"text":"Ja und sie zieht ein wichtiges Resümee","speaker":"Runa","voiceRole":"female","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"story","type":"story-line","idx":6,"text":"Sicherlich wird diese Studie viel diskutiert","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"beurteilen","voiceRole":"female","pos":"verb","control":"button.vword-voice[data-g=female]","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"beurteilen","voiceRole":"male","pos":"verb","control":"button.vword-voice[data-g=male]","chapter":"b2-08-valenz-von-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"bewusst","voiceRole":"female","pos":"adjective","control":"button.vw