-g=male]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":30,"text":"bilingual","voiceRole":"female","pos":"adjective","control":"button.vword-voice[data-g=female]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":30,"text":"bilingual","voiceRole":"male","pos":"adjective","control":"button.vword-voice[data-g=male]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"das Cello","voiceRole":"female","pos":"noun","gender":"n","control":"button.vword-voice[data-g=female]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"das Cello","voiceRole":"male","pos":"noun","gender":"n","control":"button.vword-voice[data-g=male]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"daherkommen","voiceRole":"female","pos":"verb","control":"button.vword-voice[data-g=female]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"daherkommen","voiceRole":"male","pos":"verb","control":"button.vword-voice[data-g=male]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"das Defizit","voiceRole":"female","pos":"noun","gender":"n","control":"button.vword-voice[data-g=female]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"das Defizit","voiceRole":"male","pos":"noun","gender":"n","control":"button.vword-voice[data-g=male]","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"reading","type":"reading-passage","idx":1,"text":"Interview mit Lena Fischer die nach zehn Jahren als Bankangestellte eine Umschulung zur Musiklehrerin gemacht hat Frage Was hat Sie dazu bewegt Lena Ich habe irgendwann gemerkt dass mein Alltag an der Bank nur noch aus Verhandlungen und Zahlen bestand Das Cello das ich als Kind gelernt hatte kam mir dabei völlig abhanden Also habe ich mich für eine Berufsschule beworben Frage Verlangt eine solche Umschulung nicht viel Mut Lena Ja aber ich wollte nicht länger nur vorgeben zufrieden zu sein Am Anfang kam es mir seltsam vor wieder Schülerin zu sein Inzwischen unterrichte ich sogar bilingual auf Deutsch und Englisch und die Aussicht auf eine echte berufliche Verbesserung motiviert mich jeden Tag aufs Neue","authoredText":"Interview mit Lena Fischer, die nach zehn Jahren als Bankangestellte eine Umschulung zur Musiklehrerin gemacht hat. Frage: Was hat Sie dazu bewegt? Lena: Ich habe irgendwann gemerkt, dass mein Alltag an der Bank nur noch aus Verhandlungen und Zahlen bestand. Das Cello, das ich als Kind gelernt hatte, kam mir dabei völlig abhanden. Also habe ich mich für eine Berufsschule beworben. Frage: Verlangt eine solche Umschulung nicht viel Mut? Lena: Ja, aber ich wollte nicht länger nur vorgeben, zufrieden zu sein. Am Anfang kam es mir seltsam vor, wieder Schülerin zu sein. Inzwischen unterrichte ich sogar bilingual, auf Deutsch und Englisch, und die Aussicht auf eine echte berufliche Verbesserung motiviert mich jeden Tag aufs Neue.","voiceRole":"narrator-female","title":"Interview: Von der Bank auf die Bühne","control":"button \"Listen to passage\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, ich überlege wirklich, mich noch mal umschulen zu lassen.","speaker":"Britta","voiceRole":"female","authoredLineId":"B2_010_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Das erfordert bestimmt viel Geduld in deinem Alter, oder?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_010_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Ja, aber ich habe schon eine gute Berufsschule entdeckt, die genau das anbietet.","speaker":"Britta","voiceRole":"female","authoredLineId":"B2_010_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Das beeindruckt mich echt, du gibst nicht so schnell auf.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_010_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, ich überlege wirklich, mich noch mal umschulen zu lassen.","speaker":"Britta","voiceRole":"female","authoredLineId":"B2_010_L001","reachable":false},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Das erfordert bestimmt viel Geduld in deinem Alter, oder?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_010_L002","reachable":false},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"listening","type":"listening-authored-line","idx":3,"text":"Ja, aber ich habe schon eine gute Berufsschule entdeckt, die genau das anbietet.","speaker":"Britta","voiceRole":"female","authoredLineId":"B2_010_L003","reachable":false},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"listening","type":"listening-authored-line","idx":4,"text":"Das beeindruckt mich echt, du gibst nicht so schnell auf.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_010_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Ich überlege, mich noch mal umschulen zu lassen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Du überlegst eine Umschulung. Sag es deinem Freund.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Ja, aber ich habe schon eine gute Berufserfahrung.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Er sagt, das erfordere Geduld. Antworte.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Ich gehe ruhig vor und verlange eine angemessene Verteilung.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Chefin fragt, wie du bei der Verhandlung vorgehst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Es ist vorgekommen, dass jemand zu aggressiv aufgetreten ist.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Eine Kollegin fragt, was bei der Unstimmigkeit vorgekommen ist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Ich gehe offen damit um und verrate nichts weiter.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-10-haeufige-b2-verben","level":"B2"},{"chapter":"b2-10-haeufige-b2-verben","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Ein Kollege fragt, wie du mit Kritik umgehst.","voiceRole":"narrator-