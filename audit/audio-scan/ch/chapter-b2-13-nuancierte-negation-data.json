"B2"},{"section":"vocabulary","type":"vocab-headword","idx":30,"text":"die Sprachenpolitik","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":30,"text":"die Sprachenpolitik","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"der/die Stellvertreter/in","voiceRole":"female","pos":"noun","gender":"m/f","control":"button.vword-voice[data-g=female]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":31,"text":"der/die Stellvertreter/in","voiceRole":"male","pos":"noun","gender":"m/f","control":"button.vword-voice[data-g=male]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"der/die Trendforscher/in","voiceRole":"female","pos":"noun","gender":"m/f","control":"button.vword-voice[data-g=female]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":32,"text":"der/die Trendforscher/in","voiceRole":"male","pos":"noun","gender":"m/f","control":"button.vword-voice[data-g=male]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"der Wahrnehmungsbereich","voiceRole":"female","pos":"noun","gender":"m","control":"button.vword-voice[data-g=female]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":33,"text":"der Wahrnehmungsbereich","voiceRole":"male","pos":"noun","gender":"m","control":"button.vword-voice[data-g=male]","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"reading","type":"reading-passage","idx":1,"text":"Liebes Tagebuch heute hatte ich meinen ersten Termin bei einer Psychologin Nicht die Psychologin selbst hat mich überzeugt sondern ihre Gebärdensprache Ich bin zwar nicht zweisprachig aufgewachsen aber ich lerne seit einem Monat begeistert Meine Therapeutin meint kein Wunder dass mir das Fingeralphabet anfangs schwerfällt Keineswegs unlogisch findet sie meinen Wunsch irgendwann als Bibliothekarin in einer zweisprachigen Bücherei zu arbeiten Noch bin ich keineswegs perfekt aber ich bereue meine Entscheidung kein bisschen","authoredText":"Liebes Tagebuch, heute hatte ich meinen ersten Termin bei einer Psychologin. Nicht die Psychologin selbst hat mich überzeugt, sondern ihre Gebärdensprache. Ich bin zwar nicht zweisprachig aufgewachsen, aber ich lerne seit einem Monat begeistert. Meine Therapeutin meint, kein Wunder, dass mir das Fingeralphabet anfangs schwerfällt. Keineswegs unlogisch findet sie meinen Wunsch, irgendwann als Bibliothekarin in einer zweisprachigen Bücherei zu arbeiten. Noch bin ich keineswegs perfekt, aber ich bereue meine Entscheidung kein bisschen.","voiceRole":"narrator-female","title":"Tagebucheintrag: Mein Weg zur Gebärdensprache","control":"button \"Listen to passage\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, mein Sohn ist nicht unbedingt schüchtern, er ist einfach schnell überfordert.","speaker":"Frauke","voiceRole":"female","authoredLineId":"B2_013_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Verstehe.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_013_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Reagiert er dann gar nicht mehr, oder zieht er sich nur kurz zurück?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_013_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Er zieht sich nie ganz zurück, aber er braucht eben etwas mehr Zeit als andere.","speaker":"Frauke","voiceRole":"female","authoredLineId":"B2_013_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-13-nuancierte-negation","level":"B2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Das klingt keinesfalls ungewöhnlich, viele Kinder sind so.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_013_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, mein Sohn ist nicht unbedingt schüchtern, er ist einfach schnell überfordert.","speaker":"Frauke","voiceRole":"female","authoredLineId":"B2_013_L001","reachable":false},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Verstehe. Reagiert er dann gar nicht mehr, oder zieht er sich nur kurz zurück?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_013_L002","reachable":false},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"listening","type":"listening-authored-line","idx":3,"text":"Er zieht sich nie ganz zurück, aber er braucht eben etwas mehr Zeit als andere.","speaker":"Frauke","voiceRole":"female","authoredLineId":"B2_013_L003","reachable":false},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"listening","type":"listening-authored-line","idx":4,"text":"Das klingt keinesfalls ungewöhnlich, viele Kinder sind so.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_013_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Er ist nicht unbedingt schüchtern, er ist einfach schnell überfordert.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Eine Freundin fragt, ob dein Sohn schüchtern ist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Er reagiert nicht gar nicht, er zieht sich nur kurz zurück.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Sie fragt, ob er dann gar nicht mehr reagiert.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Das ist nicht ganz falsch, aber auch nicht wesentlich.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Ein Kollege fragt, ob der Vorwurf stimmt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Ich fand es nicht besonders witzig, aber auch nicht verwunderlich.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Deine Chefin fragt, ob du den Umgang witzig fandest.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Er war nicht schlecht, nur nicht sehr erholsam.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-13-nuancierte-negation","level":"B2"},{"chapter":"b2-13-nuancierte-negation","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":5,"text