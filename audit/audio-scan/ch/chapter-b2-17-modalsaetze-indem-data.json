speaking","type":"speaking-model","idx":3,"text":"Du wirkst sicherer, indem du langsam sprichst und Fragen stellst.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-17-modalsaetze-indem","level":"B2"},{"chapter":"b2-17-modalsaetze-indem","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Ein Freund fragt, wie er im Gespräch sicherer wirkt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Ich verbessere sie, indem ich klare Absprachen einführe.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-17-modalsaetze-indem","level":"B2"},{"chapter":"b2-17-modalsaetze-indem","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Deine Chefin fragt, wie du die Arbeitsweise verbessern willst.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Du bekommst Ausdauer, indem du jeden Tag nur zwanzig Minuten übst.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-17-modalsaetze-indem","level":"B2"},{"chapter":"b2-17-modalsaetze-indem","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Ein Praktikant fragt, wie er Ausdauer beim Lernen bekommt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Ich habe Aufsehen erregt, indem ich das Projekt beschrieben habe. — Und ich punkte, indem ich die Anschrift korrigiere.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-17-modalsaetze-indem","level":"B2"},{"chapter":"b2-17-modalsaetze-indem","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Rollenspiel: Ihr besprecht die Bewerbung.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":5,"story-play-all":1,"vword-voice-F":54,"vword-voice-M":54,"vword-listen":54,"