r-female","title":"Nachrichtenbericht: Spendenaufruf nach der Flut","control":"button \"Listen to passage\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Vera, die Spendenaktion war doch ein Erfolg, oder?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_025_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Ja, es wurden viele Lebensmittel gesammelt und anschließend verteilt.","speaker":"Vera","voiceRole":"female","authoredLineId":"B2_025_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Trotzdem reicht es nicht für alle Familien.","speaker":"Vera","voiceRole":"female","authoredLineId":"B2_025_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Und was schlägst du deshalb vor?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_025_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Deshalb planen wir eine zweite Aktion, denn der Bedarf ist folglich einfach zu groß.","speaker":"Vera","voiceRole":"female","authoredLineId":"B2_025_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Vera, die Spendenaktion war doch ein Erfolg, oder?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_025_L001","reachable":false},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Ja, es wurden viele Lebensmittel gesammelt und anschließend verteilt. Trotzdem reicht es nicht für alle Familien.","speaker":"Vera","voiceRole":"female","authoredLineId":"B2_025_L002","reachable":false},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"listening","type":"listening-authored-line","idx":3,"text":"Und was schlägst du deshalb vor?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_025_L003","reachable":false},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"listening","type":"listening-authored-line","idx":4,"text":"Deshalb planen wir eine zweite Aktion, denn der Bedarf ist folglich einfach zu groß.","speaker":"Vera","voiceRole":"female","authoredLineId":"B2_025_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Ja, es wurden viele Lebensmittel gesammelt und anschließend verteilt.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Ein Freund fragt, ob die Spendenaktion ein Erfolg war.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Trotzdem machen wir weiter, denn jede Spende hilft.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Er sagt, es reiche nicht für alle. Antworte.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Die Preise sind gestiegen, daher liegen wir über dem Budget.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Chefin fragt, warum die Kosten gestiegen sind.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Die Zahlen wurden geprüft, folglich sind die Angaben belastbar.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Eine Kollegin fragt, was aus der Prüfung folgt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Alle arbeiten unbezahlt, deshalb bleibt mehr für die Bedürftigen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Ein Bekannter fragt, warum die Aktion unentgeltlich läuft.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":6,"text":"Wir haben viel gesammelt, dennoch fehlt es an Geld. — Folglich brauchen wir mehr Helfer.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"b2-25-verbindungsadverbien","level":"B2"},{"chapter":"b2-25-verbindungsadverbien","level":"B2","section":"speaking","type":"speaking-task-prompt","idx":6,"text":"Rollenspiel: Ihr berichtet über die Aktion.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":6,"story-play-all":1,"vword-voice-F":53,"vword-voice-M":53,"vword-listen":53,"listen-to-passage":1,"audio-play-btn":1,"hear-model":6},"surfaces":[{"n":1,"w":"Strategien","from":"vocab-plural","type":"Noun · plural"},{"n":13,"w":"die","from":"vocab-article","type":"Article"},{"n":1,"w":"Strecken","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Süchte","from":"vocab-plural","type":"Noun · plural"},{"n":7,