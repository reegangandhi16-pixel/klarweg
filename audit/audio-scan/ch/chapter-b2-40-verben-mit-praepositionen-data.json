-g=female]","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":50,"text":"die Pfeife","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"reading","type":"reading-passage","idx":1,"text":"Der Kommissar erinnert sich an einen ähnlichen Kunstraub vor zehn Jahren Damals wartete man monatelang auf einen entscheidenden Hinweis Diesmal freut sich der Kommissar schon nach zwei Tagen über einen anonymen Tipp Er kämpft seitdem für die Rückgabe des Gemäldes Die Ermittler freuen sich außerdem über die Unterstützung der Öffentlichkeit und bitten weiterhin um jeden noch so kleinen Hinweis Sein Kollege glaubt fest an einen baldigen Durchbruch","authoredText":"Der Kommissar erinnert sich an einen ähnlichen Kunstraub vor zehn Jahren. Damals wartete man monatelang auf einen entscheidenden Hinweis. Diesmal freut sich der Kommissar schon nach zwei Tagen über einen anonymen Tipp. Er kämpft seitdem für die Rückgabe des Gemäldes. Die Ermittler freuen sich außerdem über die Unterstützung der Öffentlichkeit und bitten weiterhin um jeden noch so kleinen Hinweis. Sein Kollege glaubt fest an einen baldigen Durchbruch.","voiceRole":"narrator-female","title":"Kriminalbericht: Der Kommissar ermittelt weiter","control":"button \"Listen to passage\"","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, hast du schon gehört?","speaker":"Doreen","voiceRole":"female","authoredLineId":"B2_040_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Eine Giraffe ist aus ihrem Gehege ausgebrochen!","speaker":"Doreen","voiceRole":"female","authoredLineId":"B2_040_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Was?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_040_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Ich hoffe wirklich auf eine schnelle Rückkehr.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_040_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Ich ärgere mich total über die schlechte Absicherung dort.","speaker":"Doreen","voiceRole":"female","authoredLineId":"B2_040_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":6,"text":"Verständlich.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_040_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"section":"listening","type":"listening-sentence","idx":7,"text":"Der Zoo muss sich jetzt dringend um bessere Zäune kümmern.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_040_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-40-verben-mit-praepositionen","level":"B2"},{"chapter":"b2-40-verben-mit-praepositionen","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, hast du schon gehört? Eine Giraffe ist aus ihrem Gehege ausgebrochen!","speaker":"Doreen","voiceRole":"female","authoredLineId":"B2_040_L001","reachable":false},{"chapter":"b2-40-verben-mit-praepositionen","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Was? Ich hoffe wirklich auf eine schnelle Rückkehr.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_040_L002","reachable":false},{"chapter":"b2-40-verben-mit-prae