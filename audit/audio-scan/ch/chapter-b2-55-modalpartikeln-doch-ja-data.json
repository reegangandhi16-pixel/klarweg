tion":"vocabulary","type":"vocab-headword","idx":21,"text":"die Kaution","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":21,"text":"die Kaution","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":22,"text":"klären","voiceRole":"female","pos":"verb","control":"button.vword-voice[data-g=female]","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":22,"text":"klären","voiceRole":"male","pos":"verb","control":"button.vword-voice[data-g=male]","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"reading","type":"reading-passage","idx":1,"text":"Lisa Du weißt doch dass die Kaution bis Freitag überwiesen sein muss Max Ja ich habe das ja nicht vergessen Ich schätze die Höflichkeit des Vermieters übrigens sehr Lisa Stimmt und seine Hilfsbereitschaft macht den Umzug doch gleich viel einfacher Lisa Hast du eigentlich schon Kartons besorgt Max Ja die stehen doch schon seit Tagen im Flur","authoredText":"Lisa: Du weißt doch, dass die Kaution bis Freitag überwiesen sein muss. Max: Ja, ich habe das ja nicht vergessen. Ich schätze die Höflichkeit des Vermieters übrigens sehr. Lisa: Stimmt, und seine Hilfsbereitschaft macht den Umzug doch gleich viel einfacher. Lisa: Hast du eigentlich schon Kartons besorgt? Max: Ja, die stehen doch schon seit Tagen im Flur.","voiceRole":"narrator-female","title":"Chat: Die Kaution für die neue Wohnung","control":"button \"Listen to passage\"","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, ich finde meine Schlüssel nicht!","speaker":"Ines","voiceRole":"female","authoredLineId":"B2_055_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Die liegen doch auf dem Tisch, hab ich gesehen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_055_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Nein, da sind sie ja nicht, ich hab schon nachgeschaut!","speaker":"Ines","voiceRole":"female","authoredLineId":"B2_055_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Schau mal in deiner Jacke — ah, da sind sie ja!","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_055_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-55-modalpartikeln-doch-ja","level":"B2"},{"chapter":"b2-55-modalpartikeln-doch-ja","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, ich finde meine Schlüssel nicht!","speaker":"Ines","voiceRole":"female","authoredLineId":"B2_055_L001","reachable":false},{"chapter":"b2-55-modalpartikeln-doch-ja","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Die liegen doch auf dem Tisch, hab ich gesehen.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_055_L002","reachable":false},{"chapter":"b2-55-modalpartikeln-doch-ja","level":"B2","section":"listening","type":"listening-authored-line","idx":3,"text":"Nein, da sind sie ja nicht, ich hab schon nachgeschaut!","speaker":"Ines","voiceRole":"female","authoredLineId":"B2_055_L003","reachable":false},{"chapter":"b2-55-modalpartikeln-doch-ja","level":"B2","section":"listening","type":"listening-authored-line","idx":4,"text":"Schau mal in deiner Jacke — ah, da sind sie ja!","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_055_L004","reachable":false},{"section