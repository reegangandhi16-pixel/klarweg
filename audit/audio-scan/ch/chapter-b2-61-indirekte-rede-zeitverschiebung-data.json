,{"section":"listening","type":"listening-sentence","idx":1,"text":"Marlen, der Kunde am Telefon klang ziemlich sauer.","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_061_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Was wollte er?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_061_L001","control":"button.audio-play-btn (sequence)","chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Er sagte, das Paket sei nie angekommen, obwohl er schon vor zwei Wochen bezahlt habe.","speaker":"Marlen","voiceRole":"female","authoredLineId":"B2_061_L002","control":"button.audio-play-btn (sequence)","chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Und was hast du ihm versprochen?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_061_L003","control":"button.audio-play-btn (sequence)","chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Ich habe gesagt, wir würden das noch heute mit dem Versand klären.","speaker":"Marlen","voiceRole":"female","authoredLineId":"B2_061_L004","control":"button.audio-play-btn (sequence)","chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2"},{"chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2","section":"listening","type":"listening-authored-line","idx":1,"text":"Marlen, der Kunde am Telefon klang ziemlich sauer. Was wollte er?","speaker":"Timo","voiceRole":"male","authoredLineId":"B2_061_L001","reachable":false},{"chapter":"b2-61-indirekte-rede-zeitverschiebung","level":"B2","section":"listening","type":"listening-authored-line","idx":2,"text":"Er sagte, das Paket sei nie angekommen, obwohl er schon vor zwei Wochen bezahlt habe.","speaker"