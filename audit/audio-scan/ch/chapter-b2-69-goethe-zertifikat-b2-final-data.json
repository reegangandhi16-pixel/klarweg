{"chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2","number":69,"title":"Goethe-Zertifikat B2 Final","rows":[{"section":"story","type":"story-line","idx":1,"text":"Morgen müssen wir vier Fertigkeiten bewältigen","speaker":"Katrin","voiceRole":"female","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"story","type":"story-line","idx":2,"text":"Ich bin mir nicht ganz sicher über die Bewertung","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"story","type":"story-line","idx":3,"text":"Da wir so viel geübt haben sollten wir unsere Bereitschaft zeigen","speaker":"Katrin","voiceRole":"female","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"story","type":"story-line","idx":4,"text":"Du hast recht Ich werde gründlich vorbereitet sein","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"story","type":"story-line","idx":5,"text":"Genau Wir schaffen das zusammen","speaker":"Katrin","voiceRole":"female","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"story","type":"story-line","idx":6,"text":"Ja das schaffen wir","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Fertigkeit","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Fertigkeit","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"b2-69-goethe-zertifikat-b2-final","level":"B2"},{"section":"vocabulary","type":