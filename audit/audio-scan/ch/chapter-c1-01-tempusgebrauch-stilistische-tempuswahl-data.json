{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","number":1,"title":"Tempusgebrauch & Stilistische Tempuswahl","rows":[{"section":"story","type":"story-line","idx":1,"text":"Ich habe das historische Präsens für die Eröffnungsszene genutzt","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Das ist eine kluge Tempuswahl da es Spannung erzeugt","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Danach wechsle ich zur Zeitschichtung im mittleren Absatz","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Ist das nicht verwirrend für die Leser","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Meine Vermutung ist dass die Leser den Wechsel klar erkennen","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Meine Schlussfolgerung ist dass der Artikel insgesamt gelungen ist","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"story","type":"story-line","idx":7,"text":"Danke Deine Rückmeldung hilft mir sehr","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"das historische Präsens","voiceRole":"female","pos":"Noun · neut.","control":"button.vword-voice[data-g=female]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"das historische Präsens","voiceRole":"male","pos":"Noun · neut.","control":"button.vword-voice[data-g=male]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"die Tempuswahl","voiceRole":"female","pos":"Noun · fem.","control":"button.vword-voice[data-g=female]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"die Tempuswahl","voiceRole":"male","pos":"Noun · fem.","control":"button.vword-voice[data-g=male]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":3,"text":"die Zeitschichtung","voiceRole":"female","pos":"Noun · fem.","control":"button.vword-voice[data-g=female]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":3,"text":"die Zeitschichtung","voiceRole":"male","pos":"Noun · fem.","control":"button.vword-voice[data-g=male]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":4,"text":"die Vermutung","voiceRole":"female","pos":"Noun · fem.","control":"button.vword-voice[data-g=female]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":4,"text":"die Vermutung","voiceRole":"male","pos":"Noun · fem.","control":"button.vword-voice[data-g=male]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":5,"text":"die Schlussfolgerung","voiceRole":"female","pos":"Noun · fem.","control":"button.vword-voice[data-g=female]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":5,"text":"die Schlussfolgerung","voiceRole":"male","pos":"Noun · fem.","control":"button.vword-voice[data-g=male]","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Ein Team der Technischen Universität Dresden präsentiert heute die Ergebnisse einer außergewöhnlichen Studie zur Energiespeicherung Bereits seit fünf Jahren hatten die Forscher an dem neuen Material gearbeitet bevor der Durchbruch gelang Laut der Studienleiterin habe man zunächst mit deutlich geringeren Wirkungsgraden gerechnet Die Fachwelt reagiert überrascht Mehrere Institute wollen die Ergebnisse in den kommenden Monaten unabhängig überprüfen Bis dahin so vermuten Branchenkenner werden die Wissenschaftler ihre Methode bereits weiterentwickelt haben","authoredText":"Ein Team der Technischen Universität Dresden präsentiert heute die Ergebnisse einer außergewöhnlichen Studie zur Energiespeicherung. Bereits seit fünf Jahren hatten die Forscher an dem neuen Material gearbeitet, bevor der Durchbruch gelang. Laut der Studienleiterin habe man zunächst mit deutlich geringeren Wirkungsgraden gerechnet. Die Fachwelt reagiert überrascht: Mehrere Institute wollen die Ergebnisse in den kommenden Monaten unabhängig überprüfen. Bis dahin, so vermuten Branchenkenner, werden die Wissenschaftler ihre Methode bereits weiterentwickelt haben.","voiceRole":"narrator-female","title":"Wissenschaftsnachricht: Neuer Energiespeicher aus Dresden","control":"button \"Listen to passage\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Meret, in deinem Entwurf wechselst du mitten im Absatz vom Präteritum ins Präsens.","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_001_L001","control":"button.audio-play-btn (sequence)","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"War das Absicht?","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_001_L001","control":"button.audio-play-btn (sequence)","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Ja, genau da will ich die Spannung erhöhen — das historische Präsens zieht den Leser direkt ins Geschehen.","speaker":"Meret","voiceRole":"female","authoredLineId":"C1_001_L002","control":"button.audio-play-btn (sequence)","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Interessant, aber wirkt das nicht sprunghaft, wenn man es nicht kennt?","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_001_L003","control":"button.audio-play-btn (sequence)","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Vielleicht, deshalb setze ich den Wechsel bewusst nur an einer einzigen Stelle ein.","speaker":"Meret","voiceRole":"female","authoredLineId":"C1_001_L004","control":"button.audio-play-btn (sequence)","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"listening","type":"listening-authored-line","idx":1,"text":"Meret, in deinem Entwurf wechselst du mitten im Absatz vom Präteritum ins Präsens. War das Absicht?","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_001_L001","reachable":false},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"listening","type":"listening-authored-line","idx":2,"text":"Ja, genau da will ich die Spannung erhöhen — das historische Präsens zieht den Leser direkt ins Geschehen.","speaker":"Meret","voiceRole":"female","authoredLineId":"C1_001_L002","reachable":false},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"listening","type":"listening-authored-line","idx":3,"text":"Interessant, aber wirkt das nicht sprunghaft, wenn man es nicht kennt?","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_001_L003","reachable":false},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"listening","type":"listening-authored-line","idx":4,"text":"Vielleicht, deshalb setze ich den Wechsel bewusst nur an einer einzigen Stelle ein.","speaker":"Meret","voiceRole":"female","authoredLineId":"C1_001_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Genau dort will ich die Spannung erhöhen; das historische Präsens holt die Szene näher.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Timo fragt: Warum wechselst du mitten im Absatz vom Präteritum ins Präsens?","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"1989 fällt die Mauer: die Menschen strömen zur Grenze, und die Wachen zögern.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Erzähl der Lerngruppe ein historisches Ereignis so, dass es unmittelbar wirkt.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Der Hintergrund steht im Präteritum, die Zitate im Perfekt, die Deutung im Präsens.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Betreuerin fragt, welche Zeitschichtung dein Kapitel hat.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Er wird die Konferenz abgesagt haben.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Der Kollege ist seit Tagen nicht erreichbar. Formuliere eine Vermutung.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Ja, die Tempuswahl war Absicht: im Präsens klingt die Schlussfolgerung verbindlicher.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1"},{"chapter":"c1-01-tempusgebrauch-stilistische-tempuswahl","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Meret fragt, ob die Tempuswahl im Vortrag Absicht war. Begründe sie.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":7,"story-play-all":1,"vword-voice-F":5,"vword-voice-M":5,"vword-listen":5,"listen-to-passage":1,"audio-play-btn":1,"hear-model":5},"surfaces":[{"n":1,"w":"Ein","from":"reading","type":"Article","role":"plain"},{"n":1,"w":"Team","from":"reading","type":"Noun · neut.","role":"plain"},{"n":1,"w":"der","from":"reading","type":"Article · Genitiv","role":"plain"},{"n":1,"w":"Technischen","from":"reading","type":"Adjective · Genitiv","role":"plain"},{"n":1,"w":"Universität","from":"reading","type":"Noun · fem.","role":"plain"},{"n":1,"w":"Dresden","from":"reading","type":"Name","role":"plain"},{"n":1,"w":"präsentiert","from":"reading","type":"Verb (Präsens)","rol