{"chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1","number":5,"title":"Zweiteilige Satzverbindungen","rows":[{"section":"story","type":"story-line","idx":1,"text":"Die Kandidatin überzeugt sowohl fachlich als auch menschlich","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Stimmt aber weder ihre Erfahrung noch ihre Sprachkenntnisse reichen aus","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Zwar fehlt ihr Erfahrung aber sie lernt sehr schnell","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Je schneller sie lernt desto eher wird sie produktiv","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Sollen wir entweder sie einstellen oder noch warten","speaker":"Silke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Ich bin für die Einstellung Ihr Potenzial überzeugt mich","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"sowohl ... als auch","voiceRole":"female","pos":"Korrelativkonnektor","control":"button.vword-voice[data-g=female]","chapter":"c1-05-zweiteilige-satzverbindungen","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"sowohl ... als auch","voiceRole":"male","pos":"Korrelativkonnektor","control":"button.vword