{"chapter":"c1-06-goethe-mini-1","level":"C1","number":6,"title":"Goethe Mini 1","rows":[{"section":"story","type":"story-line","idx":1,"text":"Meine Prüfungsvorbereitung läuft gut dennoch fehlt mir noch Übung","speaker":"Nike","voiceRole":"female","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Deine Argumentation ist überzeugend jedoch fehlt der Struktur Klarheit","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Wie finde ich einen guten Rhythmus für meine Rede","speaker":"Nike","voiceRole":"female","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Übe einfach laut sodass du ein Gefühl für den Satzbau bekommst","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Danke Ich überarbeite meine Struktur gleich","speaker":"Nike","voiceRole":"female","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Viel Erfolg bei der Prüfung","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Prüfungsvorbereitung","voiceRole":"female","pos":"Noun · fem.","control":"button.vword-voice[data-g=female]","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Prüfungsvorbereitung","voiceRole":"male","pos":"Noun · fem.","control":"button.vword-voice[data-g=male]","chapter":"c1-06-goethe-mini-1","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"die Argumentation","voiceRole":"female"