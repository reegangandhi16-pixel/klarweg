{"chapter":"c1-11-goethe-mini-2","level":"C1","number":11,"title":"Goethe Mini 2","rows":[{"section":"story","type":"story-line","idx":1,"text":"Aufgrund der Zeitknappheit brauchen wir eine klare Aufgabenteilung","speaker":"Frauke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Einverstanden Ich übernehme die Überarbeitung des Textes","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Gut Dann kümmere ich mich um die Zusammenarbeit mit dem Team","speaker":"Frauke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Bist du zuversichtlich dass wir es schaffen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Ja Da wir gut zusammenarbeiten wird es bestimmt gelingen","speaker":"Frauke","voiceRole":"female","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Dann fangen wir gleich an","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Überarbeitung","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Überarbeitung","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"c1-11-goethe-mini-2","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"die Zusammenarbeit","voiceRole":"female","po