-voice[data-g=male]","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"reading","type":"reading-passage","idx":1,"text":"Die Ausgrabungen könnten darauf hinweisen dass die Siedlung plötzlich verlassen wurde Auffällig viele Gefäße lagen noch vollständig gefüllt an Ort und Stelle Man muss daher davon ausgehen dass ein akutes Ereignis die Bewohner zur sofortigen Flucht zwang","authoredText":"Die Ausgrabungen könnten darauf hinweisen, dass die Siedlung plötzlich verlassen wurde. Auffällig viele Gefäße lagen noch vollständig gefüllt an Ort und Stelle. Man muss daher davon ausgehen, dass ein akutes Ereignis die Bewohner zur sofortigen Flucht zwang.","voiceRole":"narrator-female","title":"Kulturteil: Rätsel um eine Bronzezeit-Siedlung","control":"button \"Listen to passage\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"listening","type":"listening-sentence","idx":1,"text":"Timo, hast du dir die Verkaufszahlen von letzter Woche angesehen?","speaker":"Sina","voiceRole":"female","authoredLineId":"C1_013_L001","control":"button.audio-play-btn (sequence)","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"listening","type":"listening-sentence","idx":2,"text":"Die können doch nicht stimmen.","speaker":"Sina","voiceRole":"female","authoredLineId":"C1_013_L001","control":"button.audio-play-btn (sequence)","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"listening","type":"listening-sentence","idx":3,"text":"Das könnte an einem Systemfehler liegen — so ein Einbruch wäre sonst unerklärlich.","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_013_L002","control":"button.audio-play-btn (sequence)","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"listening","type":"listening-sentence","idx":4,"text":"Möglich, aber es könnte auch schlicht ein menschlicher Fehler bei der Eingabe sein.","speaker":"Sina","voiceRole":"female","authoredLineId":"C1_013_L003","control":"button.audio-play-btn (sequence)","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"listening","type":"listening-sentence","idx":5,"text":"Beides müssen wir prüfen, bevor wir dem Chef Bericht erstatten.","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_013_L004","control":"button.audio-play-btn (sequence)","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"listening","type":"listening-authored-line","idx":1,"text":"Timo, hast du dir die Verkaufszahlen von letzter Woche angesehen? Die können doch nicht stimmen.","speaker":"Sina","voiceRole":"female","authoredLineId":"C1_013_L001","reachable":false},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"listening","type":"listening-authored-line","idx":2,"text":"Das könnte an einem Systemfehler liegen — so ein Einbruch wäre sonst unerklärlich.","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_013_L002","reachable":false},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"listening","type":"listening-authored-line","idx":3,"text":"Möglich, aber es könnte auch schlicht ein menschlicher Fehler bei der Eingabe sein.","speaker":"Sina","voiceRole":"female","authoredLineId":"C1_013_L003","reachable":false},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"listening","type":"listening-authored-line","idx":4,"text":"Beides müssen wir prüfen, bevor wir dem Chef Bericht erstatten.","speaker":"Timo","voiceRole":"male","authoredLineId":"C1_013_L004","reachable":false},{"section":"speaking","type":"speaking-model","idx":1,"text":"Das könnte an einem Systemfehler liegen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":1,"text":"Timo hält die Verkaufszahlen für falsch. Nenne eine Ursache.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":2,"text":"Jemand muss noch hier sein, die Tür war nicht verschlossen.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":2,"text":"Das Labor ist offen und das Licht brennt. Was folgerst du?","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":3,"text":"Die Abweichung dürfte am Gerät liegen, ausschließen kann ich es nicht.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":3,"text":"Deine Kollegin fragt, ob ein Gerätefehler auszuschließen ist.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":4,"text":"Die Daten könnten darauf hinweisen, dass der Effekt altersabhängig ist.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":4,"text":"Deine Betreuerin findet deinen Befund zu bestimmt formuliert. Sag ihn vorsichtiger.","voiceRole":"narrator-female","reachable":false},{"section":"speaking","type":"speaking-model","idx":5,"text":"Wir gehen davon aus, dass der Einbruch nur einen Monat betrifft.","voiceRole":"narrator-female","control":"button \"Hear model\"","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","section":"speaking","type":"speaking-task-prompt","idx":5,"text":"Eine Kollegin fragt, wovon ihr im Bericht ausgeht.","voiceRole":"narrator-female","reachable":false}],"controls":{"story-play-line":6,"story-play-all":1,"vword-voice-F":5,"vword-voice-M":5,"vword-listen":5,"listen-to-passage":1,"audio-play-btn":1,"hear-model":5},"surfaces":[{"n":1,"w":"Vermutungen","from":"vocab-plural","type":"Noun · plural"},{"n":3,"w":"die","from":"vocab-article","type":"Article"},{"n":1,"w":"Schlussfolgerungen","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"Hinweise","from":"vocab-plural","type":"Noun · plural"},{"n":1,"w":"der","from":"vocab-article","type":"Article"},{"n":1,"w":"Die","from":"reading","type":"Article","role":"plain"},{"n":1,"w":"Ausgrabungen","from":"reading","type":"Noun · plural","role":"plain"},{"n":1,"w":"könnten","from":"reading","type":"Modalverb (Konjunktiv II)","role":"r-akademisch"},{"n":1,"w":"darauf","from":"reading","type":"Pronominaladverb","role":"r-akademisch"},{"n":1,"w":"hinweisen","from":"reading","type":"Verb · Infinitiv","role":"r-akademisch"},{"n":2,"w":"dass","from":"reading","type":"Konjunktion","role":"plain"},{"n":1,"w":"Siedlung","from":"reading","type":"Noun · fem.","role":"plain"},{"n":1,"w":"plötzlich","from":"reading","type":"Adverb","role":"plain"},{"n":1,"w":"verlassen","from":"reading","type":"Verb · Partizip II","role":"plain"},{"n":1,"w":"wurde","from":"reading","type":"Verb · werden (Präteritum Passiv, Nebensatz, Satzende)","role":"plain"},{"n":1,"w":"Auffällig","from":"reading","type":"Adjective","role":"plain"},{"n":1,"w":"viele","from":"reading","type":"Adjective","role":"plain"},{"n":1,"w":"Gefäße","from":"reading","type":"Noun · plural","role":"plain"},{"n":1,"w":"lagen","from":"reading","type":"Verb · liegen (Präteritum)","role":"plain"},{"n":1,"w":"noch","from":"reading","type":"Ad