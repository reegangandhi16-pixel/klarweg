{"chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1","number":13,"title":"Vermutungen mit Modalverben ausdrücken","rows":[{"section":"story","type":"story-line","idx":1,"text":"Die Verkaufszahlen müssen fehlerhaft sein","speaker":"Sina","voiceRole":"female","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Ich gehe davon aus dass es ein Systemfehler ist","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Wir dürfen menschliches Versagen nicht ausschließen","speaker":"Sina","voiceRole":"female","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Das stimmt Welche Hinweis gibt uns die Datenbank","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Meine Schlussfolgerung ist dass das Update den Fehler verursacht hat","speaker":"Sina","voiceRole":"female","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Das könnte wirklich sein Ich prüfe das gleich","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Vermutung","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"c1-13-vermutungen-mit-modalverben-ausdruecken","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Vermutung","voiceRole":"male","pos":"noun