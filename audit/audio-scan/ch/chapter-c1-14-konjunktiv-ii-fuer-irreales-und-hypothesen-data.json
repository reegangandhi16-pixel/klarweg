{"chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1","number":14,"title":"Konjunktiv II für Irreales & Hypothesen","rows":[{"section":"story","type":"story-line","idx":1,"text":"Wenn ich damals Medizin studiert hätte wäre mein Lebensweg ganz anders","speaker":"Uta","voiceRole":"female","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Wäre das wünschenswert für dich gewesen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Es ist durchaus denkbar aber ich nehme an dass ich trotzdem zufrieden wäre","speaker":"Uta","voiceRole":"female","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Woher käme diese Zufriedenheit","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Sie käme aus meiner Familie und meinen Freundschaften","speaker":"Uta","voiceRole":"female","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Das klingt nach einer weisen Erkenntnis","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"denkbar","voiceRole":"female","pos":"adjective","control":"button.vword-voice[data-g=female]","chapter":"c1-14-konjunktiv-ii-fuer-irreales-und-hypothesen","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"denkbar","voiceRole":"male","pos