{"chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1","number":15,"title":"Konjunktiv I & Indirekte Rede","rows":[{"section":"story","type":"story-line","idx":1,"text":"Der Minister behauptet er sei unschuldig","speaker":"Grit","voiceRole":"female","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Die Quelle berichtet er habe gelogen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Wir müssen die Neutralität bewahren","speaker":"Grit","voiceRole":"female","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Stimmt Ich stelle nur fest was passiert ist","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Meine Kollegin sagte die Antwort sei ausweichend gewesen","speaker":"Grit","voiceRole":"female","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Dann sollten wir nachfragen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"berichten","voiceRole":"female","pos":"verb","control":"button.vword-voice[data-g=female]","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"berichten","voiceRole":"male","pos":"verb","control":"button.vword-voice[data-g=male]","chapter":"c1-15-konjunktiv-i-und-indirekte-rede","level":"C1"},{"section":"vocabulary","type":"vocab-headword"