{"chapter":"c1-17-goethe-halbzeit-test","level":"C1","number":17,"title":"Goethe Halbzeit-Test","rows":[{"section":"story","type":"story-line","idx":1,"text":"Ich habe die Zusammenfassung geschrieben","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Sie ist vielversprechend aber ich hätte eine Anmerkung","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Welche Anmerkung meinst du","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Der letzte Absatz sollte neu analysiert werden","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Gut ich überarbeite das gleich","speaker":"Meret","voiceRole":"female","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Danke Ich bin zuversichtlich dass der Bericht gut ankommt","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Zusammenfassung","voiceRole":"female","pos":"noun","gender":"f","control":"button.vword-voice[data-g=female]","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"die Zusammenfassung","voiceRole":"male","pos":"noun","gender":"f","control":"button.vword-voice[data-g=male]","chapter":"c1-17-goethe-halbzeit-test","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"vielversprechend","voiceRo