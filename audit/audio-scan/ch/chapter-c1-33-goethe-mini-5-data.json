{"chapter":"c1-33-goethe-mini-5","level":"C1","number":33,"title":"Goethe Mini 5","rows":[{"section":"story","type":"story-line","idx":1,"text":"Ich muss den Vortrag noch einmal überprüfen","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Das Thema klingt vielversprechend","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Danke Hast du schon zugesagt","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Ja Ich werde einen wichtigen Beitrag leisten","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Möchtest du am Ende auf das Thema zurückkommen","speaker":"Doreen","voiceRole":"female","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Ja das wäre sinnvoll","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"überprüfen","voiceRole":"female","pos":"verb","control":"button.vword-voice[data-g=female]","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"überprüfen","voiceRole":"male","pos":"verb","control":"button.vword-voice[data-g=male]","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":2,"text":"vielversprechend","voiceRole":"female","pos":"adjective","control":"button.vword-voice[data-g=female]","chapter":"c1-33-goethe-mini-5","level":"C1"},{"section":"vocabulary","ty