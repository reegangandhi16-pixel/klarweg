{"chapter":"c1-40-forumsbeitrag-schreiben","level":"C1","number":40,"title":"Forumsbeitrag schreiben","rows":[{"section":"story","type":"story-line","idx":1,"text":"\"Hallo zusammen\" ist eine gute Eröffnung für den Beitrag","speaker":"Merle","voiceRole":"female","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"story","type":"story-line","idx":2,"text":"Ich kann den Ärger der Nutzer nachvollziehen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"story","type":"story-line","idx":3,"text":"Ein weiterer Aspekt ist wichtig","speaker":"Merle","voiceRole":"female","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"story","type":"story-line","idx":4,"text":"Die Diskussion sollte sachlich bleiben","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"story","type":"story-line","idx":5,"text":"Sind unsere Argumente nachvollziehbar für alle","speaker":"Merle","voiceRole":"female","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"story","type":"story-line","idx":6,"text":"Ich denke schon Wir können den Beitrag jetzt veröffentlichen","speaker":"Timo","voiceRole":"male","control":"button.story-play-line","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"hallo zusammen","voiceRole":"female","pos":"fixed forum greeting","control":"button.vword-voice[data-g=female]","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"vocabulary","type":"vocab-headword","idx":1,"text":"hallo zusammen","voiceRole":"male","pos":"fixed forum greeting","control":"button.vword-voice[data-g=male]","chapter":"c1-40-forumsbeitrag-schreiben","level":"C1"},{"section":"vocabulary","type":"vocab-he