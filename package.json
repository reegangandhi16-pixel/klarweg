{
  "name": "klarweg-audio",
  "version": "1.0.0",
  "private": true,
  "description": "Klarweg — build-time German audio generation (Google Cloud TTS) + audioUrl helper",
  "type": "module",
  "scripts": {
    "generate-audio": "tsx scripts/generate-audio.ts",
    "generate-audio:force": "tsx scripts/generate-audio.ts --force",
    "generate-audio:dry": "tsx scripts/generate-audio.ts --dry-run",
    "verify-audio-sync": "tsx scripts/verify-audio-sync.ts",
    "generate-a1-audio": "tsx scripts/generate-a1-audio.ts",
    "generate-a1-audio:dry": "tsx scripts/generate-a1-audio.ts --dry-run",
    "generate-a1-audio:stats": "tsx scripts/generate-a1-audio.ts --stats",
    "verify-audio-coverage": "tsx scripts/verify-audio-coverage.ts",
    "build-coverage": "tsx scripts/build-coverage-json.ts",
    "generate:chapter-pdfs": "node scripts/generate-chapter-resources.mjs",
    "prebuild": "npm run verify-audio-coverage",
    "test": "node exam-content/tools/check-public-boundary.mjs && node scripts/build-tutor-registry.mjs && node --test access/worker/test/*.test.mjs tutor/worker/test/*.test.mjs tutor/eval/*.test.mjs scripts/*.test.mjs && npm run check:generated",
    "build:tutor-registry": "node scripts/build-tutor-registry.mjs",
    "tutor:eval": "node tutor/eval/run-eval.mjs",
    "deploy:tutor": "cd tutor/worker && npx wrangler deploy",
    "deploy:access": "node scripts/deploy-access.mjs",
    "check:generated": "node scripts/build-grammar-index.mjs --check && node scripts/seo-chapter-meta.mjs --check",
    "test:exam": "node exam-content/tools/check-public-boundary.mjs && node exam-content/tools/validate.mjs && node --test exam-content/test/*.test.mjs exam-worker/test/*.test.mjs exam/test/*.test.mjs access/worker/test/exam-proxy.test.mjs",
    "test:exam:browser": "node exam-worker/test/browser-e2e.mjs",
    "exam:validate": "node exam-content/tools/validate.mjs",
    "exam:build": "node exam-content/tools/build-release.mjs --release r000",
    "exam:check-public": "node exam-content/tools/check-public-boundary.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
